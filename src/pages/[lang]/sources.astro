---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import Sources from '../../components/Sources.astro';
import { getI18n, languagesList } from '../../i18n/ui';

export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}

const { lang, messages } = await getI18n(Astro.url);
const s = messages.sources;
---

<BaseLayout lang={lang} title={`${s.heading} — ${messages.footer.brand.name}`} description={s.intro} messages={messages} path={`/${lang}/sources/`}>
  <main>
    <div class="bg-teakDeep text-ivory pt-28 px-5">
      <div class="max-w-5xl mx-auto">
        <a href={`/${lang}/`} class="text-sm text-goldBright hover:underline">← {messages.header.home}</a>
      </div>
    </div>
    <Sources messages={messages} standalone />
  </main>
  <Footer lang={lang} messages={messages} />
</BaseLayout>
