---
import type { Lang } from '../i18n/ui';

interface Props {
  messages: Record<string, any>;
  lang?: Lang;
}
const { messages, lang } = Astro.props;
const t = messages.transport;
---

<section id="transport" class="py-20 bg-white text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{t.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{t.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/80">{t.intro}</p>
    {lang === 'en' && (
      <a href="/en/how-to-get-there/" class="mt-3 inline-block text-sm font-medium text-gold hover:text-goldBright">
        Full directions guide (Bus 14, taxi, airport, border) →
      </a>
    )}

    <!-- Bus 14 完整攻略 -->
    <div class="mt-10 rounded-2xl bg-teak text-ivory p-6 md:p-8">
      <div class="flex flex-wrap items-center gap-3">
        <span class="chip border-gold/40 text-goldBright">{t.bus14.tag}</span>
        <h3 class="font-display text-2xl text-goldBright">{t.bus14.title}</h3>
      </div>

      <dl class="grid sm:grid-cols-3 gap-4 mt-6">
        <div class="rounded-xl bg-ivory/10 px-4 py-3">
          <dt class="text-xs uppercase tracking-wide text-ivory/60">Fare</dt>
          <dd class="font-display text-lg text-goldBright mt-1">{t.bus14.fare}</dd>
        </div>
        <div class="rounded-xl bg-ivory/10 px-4 py-3">
          <dt class="text-xs uppercase tracking-wide text-ivory/60">Frequency</dt>
          <dd class="font-display text-lg text-goldBright mt-1">{t.bus14.freq}</dd>
        </div>
        <div class="rounded-xl bg-ivory/10 px-4 py-3">
          <dt class="text-xs uppercase tracking-wide text-ivory/60">Duration</dt>
          <dd class="font-display text-lg text-goldBright mt-1">{t.bus14.duration}</dd>
        </div>
      </dl>

      <ol class="mt-6 space-y-3">
        {t.bus14.steps.map((st: string, i: number) => (
          <li class="flex gap-3 text-sm text-ivory/90">
            <span class="font-display text-goldBright mt-0.5">{i + 1}</span>
            <span class="leading-relaxed">{st}</span>
          </li>
        ))}
      </ol>

      <p class="mt-6 text-sm text-ivory/70 leading-relaxed">⚠️ {t.bus14.tip}</p>
    </div>

    <!-- 其他交通方式 -->
    <h3 class="font-display text-2xl text-teak mt-14">{t.optionsTitle}</h3>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mt-6">
      {t.options.map((o: any) => (
        <div class="rounded-2xl border border-gold/30 bg-ivory/60 p-5 flex flex-col">
          <span class="text-3xl" aria-hidden="true">{o.icon}</span>
          <h4 class="font-display text-lg text-teak mt-3">{o.name}</h4>
          <p class="mt-1 text-xs text-gold">{o.best}</p>
          <p class="mt-3 text-sm text-ink/80 leading-relaxed">{o.detail}</p>
          <p class="mt-auto pt-4 text-sm text-teak font-semibold">{o.price}</p>
        </div>
      ))}
    </div>

    <!-- 边境过境 -->
    <div class="mt-12 rounded-2xl border border-gold/30 bg-ivory/60 p-6 md:p-8">
      <h3 class="font-display text-2xl text-teak">{t.border.title}</h3>
      <p class="mt-3 text-ink/80 leading-relaxed max-w-3xl">{t.border.text}</p>
      <ol class="mt-5 space-y-2">
        {t.border.steps.map((st: string) => (
          <li class="flex gap-2 text-sm text-ink/85">
            <span class="text-gold mt-0.5" aria-hidden="true">•</span>
            <span class="leading-relaxed">{st}</span>
          </li>
        ))}
      </ol>
      <p class="mt-5 text-xs text-ink/50 leading-relaxed">{t.border.note}</p>
    </div>

    <p class="mt-8 text-xs text-ink/50 leading-relaxed max-w-3xl">{t.note}</p>
  </div>
</section>
