---
import type { Lang } from '../i18n/ui';

interface Props {
  messages: Record<string, any>;
  lang?: Lang;
}
const { messages, lang } = Astro.props;
const s = messages.sculptures;
---

<section id="sculptures" class="py-20 bg-ivory text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{s.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{s.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/80">{s.intro}</p>
    {lang === 'en' && (
      <a href="/en/sculptures/" class="mt-3 inline-block text-sm font-medium text-gold hover:text-goldBright">
        Full sculpture guide: meanings, symbolism & photo tips →
      </a>
    )}

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
      {s.items.map((it: any, i: number) => (
        <article class="rounded-2xl border border-gold/30 bg-white p-6 flex flex-col" aria-label={it.alt}>
          <div class="flex items-center justify-between gap-3">
            <span class="chip border-gold/40 text-teak">{it.tag}</span>
            <span class="font-display text-2xl text-gold" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
          </div>
          <h3 class="font-display text-xl text-teak mt-4">{it.name}</h3>
          <p class="mt-1 text-xs uppercase tracking-wide text-gold">{it.meta}</p>
          <p class="mt-3 text-ink/80 leading-relaxed">{it.desc}</p>
          <div class="mt-auto pt-4 border-t border-gold/20">
            <p class="text-sm text-ink/70">
              <span class="text-teak font-semibold">📷 </span>{it.photoTip}
            </p>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-8 text-xs text-ink/50 leading-relaxed max-w-3xl">{s.note}</p>
  </div>
</section>
