---
interface Props { lang: string; messages: Record<string, any>; }
const { lang, messages } = Astro.props;
const footer = messages.footer;
const independentNotice: Record<string, string> = {
  zh: '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。',
  en: 'This is an independent travel information project. We are not affiliated with any government agency or official organization.',
  th: 'เว็บไซต์นี้เป็นโครงการข้อมูลการท่องเที่ยวอิสระ ไม่เกี่ยวข้องกับหน่วยงานรัฐบาลหรือองค์กรทางการใด ๆ',
  fr: 'Ce site est un projet indépendant d’information touristique, sans affiliation avec une autorité publique ni un organisme officiel.',
  ko: '이 웹사이트는 독립적인 여행 정보 프로젝트이며 정부 기관이나 공식 단체와 관련이 없습니다.',
  ja: '当サイトは独立した旅行情報プロジェクトであり、政府機関や公的団体とは関係ありません。',
};
const rights: Record<string, string> = { zh: '版權所有', en: 'All rights reserved', th: 'สงวนลิขสิทธิ์', fr: 'Tous droits réservés', ko: '모든 권리 보유', ja: '無断転載を禁じます' };
---

<footer class="bg-teakDeep text-ivory py-8">
  <div class="max-w-7xl mx-auto px-5 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div class="text-xs leading-relaxed text-ivory/75 space-y-2">
      <p>© 2026 {footer.brand.name} · {rights[lang] ?? rights.en}</p>
      <p>{independentNotice[lang] ?? independentNotice.en}</p>
    </div>
    <nav aria-label={footer.privacy} class="flex flex-wrap gap-x-5 gap-y-2 text-xs md:justify-end md:text-right">
      <a href={`/${lang}/privacy-policy/`} class="text-ivory/80 hover:text-goldBright hover:underline">{footer.privacy}</a>
      <a href={`/${lang}/terms-of-service/`} class="text-ivory/80 hover:text-goldBright hover:underline">{footer.terms}</a>
      <a href={`/${lang}/cookie-settings/`} class="text-ivory/80 hover:text-goldBright hover:underline">{footer.cookies}</a>
    </nav>
  </div>
</footer>
