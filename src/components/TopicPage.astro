---
import { siteConfig } from '../config';
import { TOPIC_LINKS_UI, type Topic } from '../data/topics-en';
import { TOPIC_DETAILS_EN } from '../data/topic-details-en';

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;
const ui = TOPIC_LINKS_UI;
const detail = TOPIC_DETAILS_EN[topic.slug];
const photoSrc = (number: number) => `/gallery/${siteConfig.galleryPrefix}${number}.jpg`;
---

<section class="bg-ivory text-ink">
  <!-- 面包屑 -->
  <div class="border-b border-gold/20 bg-teak/5">
    <div class="max-w-4xl mx-auto px-5 py-3 text-sm text-ink/60">
      <a href="/en/" class="hover:text-gold">{ui.breadcrumbHome}</a>
      <span class="mx-2">/</span>
      <span class="text-teak">{topic.h1}</span>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-5 py-14">
    <p class="font-hand text-gold text-xl md:text-2xl">Buddha Park · Vientiane, Laos</p>
    <h1 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2 leading-tight">{topic.h1}</h1>
    <p class="mt-5 text-lg text-ink/80 leading-relaxed">{topic.intro}</p>
    <p class="mt-3 text-xs text-ink/50">{ui.updatedLabel}: {topic.checked}</p>

    <div class="mt-5 flex flex-wrap gap-3">
      <a href={siteConfig.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full bg-teak text-white px-5 py-2.5 text-sm font-semibold hover:bg-gold">View Buddha Park on Google Maps ↗</a>
      <a href="/en/how-to-get-there/" class="inline-flex rounded-full border border-teak/30 px-5 py-2.5 text-sm font-semibold text-teak hover:bg-teak/5">Plan transport</a>
    </div>

    {detail && (
      <>
        <div class="mt-10">
          <figure class="overflow-hidden rounded-2xl border border-gold/20 bg-white/50">
            <img src={photoSrc(detail.photos[0].number)} alt={detail.photos[0].alt} width="1200" height="800" loading="eager" class="w-full max-h-[480px] object-cover" />
            <figcaption class="px-4 py-3 text-xs text-ink/65">{detail.photos[0].caption}</figcaption>
          </figure>
        </div>

        <div class="mt-12 grid md:grid-cols-2 gap-8">
          <div>
            <h2 class="font-display text-2xl md:text-3xl text-teak">Explore the attraction</h2>
            <p class="mt-3 text-ink/80">{detail.tagline}</p>
            <h3 class="font-semibold text-lg text-teak mt-6">Visitor tips</h3>
            <ul class="mt-3 space-y-2 text-sm text-ink/80">{detail.visitTips.map((tip) => <li>• {tip}</li>)}</ul>
          </div>
          <div class="rounded-2xl bg-teak/5 border border-gold/20 p-6">
            <h3 class="font-display text-xl text-teak">What makes it special</h3>
            <ul class="mt-4 space-y-3 text-sm text-ink/80">{detail.features.map((feature) => <li>• {feature}</li>)}</ul>
          </div>
        </div>

        <section class="mt-12 rounded-2xl bg-white/65 border border-gold/25 p-6 md:p-8" aria-labelledby="park-management">
          <p class="text-sm text-gold font-semibold uppercase tracking-wider">Stewardship and heritage</p>
          <h2 id="park-management" class="font-display text-2xl md:text-3xl text-teak mt-2">About Buddha Park’s management</h2>
          <p class="mt-4 text-ink/80 leading-relaxed">Buddha Park (Wat Xieng Khuan) is in Hadxayfong District of Vientiane Capital. In 2017, the district authorities granted Lao International Travel and Investment Co., Ltd. a 30-year concession for renovation and improvement works, according to the Lao News Agency (KPL). This is a documented concession arrangement; it should not be taken as independent verification of the current day-to-day operator.</p>
          <p class="mt-3 text-ink/80 leading-relaxed">The park began in 1958 under Bunleua Sulilat and was recognized in a local national-heritage listing announced in 2022. Today its concrete Buddhist and Hindu figures, gardens and Mekong-side setting remain central to its cultural appeal. For current admission arrangements, site rules or the responsible on-site office, consult the entrance staff.</p>
          <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
            <a href="https://kpl.gov.la/EN/detail.aspx?id=27433" target="_blank" rel="noopener noreferrer" class="underline text-teak hover:text-gold">2017 concession report ↗</a>
            <a href="https://www.tourismlaos.org/2022/12/29/buddha-park-in-vientiane-capital-listed-as-national-heritage-site/" target="_blank" rel="noopener noreferrer" class="underline text-teak hover:text-gold">2022 heritage report ↗</a>
          </div>
        </section>
      </>
    )}

    <div class="mt-10 space-y-12">
      {!topic.sections.some((section) => /basic information/i.test(section.h2 ?? '')) && (
        <section>
          <h2 class="font-display text-2xl md:text-3xl text-teak mb-4">Basic information</h2>
          <div class="overflow-x-auto"><table class="w-full border border-gold/25 text-sm"><tbody>
            {[
              ['Attraction', 'Buddha Park (Wat Xieng Khouane Luang / Xieng Khuan)'],
              ['Type', 'Outdoor Buddhist and Hindu concrete sculpture park'],
              ['Address', siteConfig.streetAddress],
              ['Map reference', 'Plus Code WQ67+WW · 17.9124° N, 102.7622° E'],
              ['Built', 'From 1958; initiated by Luang Pu Bunleua Sulilat'],
              ['Visit duration', 'Roughly 1–2 hours, excluding transport (editorial estimate)'],
              ['Admission / opening', 'Paid entry; check the current posted fee and opening information on site'],
            ].map(([label,value]) => <tr class="border-b border-gold/15"><th scope="row" class="p-3 text-left text-teak bg-teak/5 w-40">{label}</th><td class="p-3 text-ink/80">{value}</td></tr>)}
          </tbody></table></div>
        </section>
      )}
      {topic.sections.map((s) => (
        <div>
          {s.h2 && <h2 class="font-display text-2xl md:text-3xl text-teak mb-4">{s.h2}</h2>}
          {s.paragraphs?.map((p) => <p class="mt-3 text-ink/80 leading-relaxed">{p}</p>)}
          {s.bullets && (
            <ul class="mt-4 space-y-2">
              {s.bullets.map((b) => (
                <li class="flex gap-2 text-ink/80">
                  <span class="text-gold mt-0.5" aria-hidden="true">•</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          )}
          {s.table && (
            <div class="mt-5 overflow-x-auto">
              <table class="w-full text-sm border border-gold/25 rounded-xl overflow-hidden">
                <thead class="bg-teak/10">
                  <tr>
                    {s.table.headers.map((h) => (
                      <th class="text-left font-semibold text-teak px-4 py-3 whitespace-nowrap">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {s.table.rows.map((r) => (
                    <tr class="border-t border-gold/15">
                      {r.map((c, i) => (
                        <td class={`px-4 py-3 align-top ${i === 0 ? 'font-medium text-teak' : 'text-ink/75'}`}>{c}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          {s.links && (
            <ul class="mt-4 space-y-2">
              {s.links.map((link) => <li><a href={link.url} target="_blank" rel="noopener noreferrer" class="text-teak underline underline-offset-4 hover:text-gold">{link.label} ↗</a></li>)}
            </ul>
          )}
        </div>
      ))}
    </div>

    {detail && (
      <section class="mt-14 space-y-8">
        <div class="grid md:grid-cols-2 gap-8">
          <div><h2 class="font-display text-2xl text-teak">Opening hours</h2><p class="mt-3 text-ink/80">The park commonly advertises daytime visiting hours. Check the current entrance notice before travelling, especially around holidays or special events.</p></div>
          <div><h2 class="font-display text-2xl text-teak">Entrance fees</h2><p class="mt-3 text-ink/80">Admission is charged at the park. Fees in older guides may differ from those posted today. See the <a href="/en/entrance-fee/" class="text-teak underline">dated ticket reports and payment tips</a>, then follow the posted gate price.</p></div>
        </div>
        <div><h2 class="font-display text-2xl text-teak">Getting to Buddha Park</h2><p class="mt-3 text-ink/80">The park is at Ban Xieng Khuan in Hadxayfong District, outside central Vientiane. Public Bus 14 is commonly used from the Talat Sao area; privately arranged transport is another option. Verify the service and return time before departure. <a href="/en/how-to-get-there/" class="text-teak underline">Read the full transport guide</a>.</p></div>
        <div><h2 class="font-display text-2xl text-teak">Visitor reviews</h2><p class="mt-3 text-ink/80">For current Google Maps ratings, the number of reviews and the original visitor comments, <a href={siteConfig.mapsUrl} target="_blank" rel="noopener noreferrer" class="text-teak underline">open the Buddha Park place listing</a>. The displayed totals are dynamic and are not reproduced in these guides.</p></div>
      </section>
    )}

    {detail && (
      <div class="mt-14 space-y-12">
        <section>
          <h2 class="font-display text-2xl md:text-3xl text-teak">Suggested walking route</h2>
          <ol class="mt-5 space-y-4">
            {detail.route.map((step, i) => <li class="flex gap-4 items-start"><span class="shrink-0 rounded-full bg-teak text-white w-9 h-9 flex items-center justify-center font-semibold">{i + 1}</span><p class="pt-1.5 text-ink/80">{step}</p></li>)}
          </ol>
        </section>
        <section class="grid md:grid-cols-2 gap-8">
          <div>
            <h2 class="font-display text-2xl text-teak">Photography viewpoint</h2>
            <p class="mt-3 leading-relaxed text-ink/80">{detail.viewpoint}</p>
          </div>
          <div>
            <h2 class="font-display text-2xl text-teak">Where to stay</h2>
            <p class="mt-3 leading-relaxed text-ink/80">{detail.stay}</p>
          </div>
        </section>
        <section>
          <h2 class="font-display text-2xl md:text-3xl text-teak">Real views of Buddha Park</h2>
          <div class="mt-5 grid sm:grid-cols-2 gap-5">
            {detail.photos.slice(1).map((photo) => <figure class="rounded-xl overflow-hidden border border-gold/20 bg-white/60"><img src={photoSrc(photo.number)} alt={photo.alt} width="900" height="650" loading="lazy" class="w-full h-64 object-cover" /><figcaption class="p-3 text-xs text-ink/70">{photo.caption}</figcaption></figure>)}
          </div>
        </section>
      </div>
    )}

    {topic.slug === 'vientiane-day-trip' && (
      <section class="mt-14">
        <h2 class="font-display text-2xl md:text-3xl text-teak">Nearby places and their own maps</h2>
        <div class="mt-5 grid sm:grid-cols-2 gap-5">
          {[
            { id: 'pha-that-luang', name: 'Pha That Luang', details: 'A national stupa with a ceremonial setting; compare its established Buddhist architectural tradition with Buddha Park’s modern concrete sculptures.', maps: 'https://www.google.com/maps/search/?api=1&query=Pha+That+Luang+Vientiane+Laos' },
            { id: 'patuxai', name: 'Patuxai', details: 'A central victory monument known for its monumental gateway form. It suits a separate city-centre stop after returning from the park.', maps: 'https://www.google.com/maps/search/?api=1&query=Patuxai+Vientiane+Laos' },
            { id: 'wat-si-saket', name: 'Wat Si Saket', details: 'A historic temple with an important collection of Buddha imagery; visit respectfully and observe any photography restrictions.', maps: 'https://www.google.com/maps/search/?api=1&query=Wat+Si+Saket+Vientiane+Laos' },
            { id: 'ho-phra-keo', name: 'Ho Phra Keo', details: 'A historic religious building and museum attraction opposite Wat Si Saket, convenient to pair when both are open.', maps: 'https://www.google.com/maps/search/?api=1&query=Ho+Phra+Keo+Vientiane+Laos' },
          ].map((place) => <article id={place.id} class="scroll-mt-24 rounded-2xl border border-gold/25 bg-white/65 p-6"><h3 class="font-display text-xl text-teak">{place.name}</h3><p class="mt-3 text-ink/80 leading-relaxed">{place.details}</p><p class="mt-3 text-sm text-ink/60">Vientiane Capital, Laos · Confirm the street entrance and current access on the place listing.</p><div class="mt-4 flex gap-4 flex-wrap"><a href={`/en/nearby/${place.id}/`} class="text-sm text-teak font-semibold underline underline-offset-4">Full attraction guide →</a><a href={place.maps} target="_blank" rel="noopener noreferrer" class="text-sm text-gold hover:text-goldBright underline underline-offset-4">Google Maps ↗</a></div></article>)}
        </div>
      </section>
    )}

    <!-- FAQ -->
    <div class="mt-14">
      <h2 class="font-display text-2xl md:text-3xl text-teak mb-5">{ui.faqTitle}</h2>
      <div class="space-y-3">
        {topic.faqs.map((f) => (
          <details class="group rounded-xl border border-gold/25 bg-white/60 p-4 open:bg-teak/5">
            <summary class="cursor-pointer font-medium text-teak flex justify-between items-center">
              {f.q}
              <span class="text-gold transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-2 text-sm text-ink/75 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>

    <!-- 地图（交通专题嵌入 Google Maps） -->
    {topic.slug === 'how-to-get-there' && (
      <div class="mt-14">
        <h2 class="font-display text-2xl text-teak mb-4">Buddha Park on the map</h2>
        <div class="rounded-2xl overflow-hidden border border-gold/25">
          <iframe
            src={siteConfig.mapsEmbedSrc}
            title="Google Maps: Buddha Park (Wat Xieng Khouane Luang), Vientiane, Laos"
            class="w-full h-80 md:h-96"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <p class="mt-2 text-xs text-ink/50">Plus Code WQ67+WW · 17.9124°N, 102.7622°E</p>
      </div>
    )}

    <!-- 相关专题互链 -->
    <div class="mt-14">
      <h2 class="font-display text-2xl text-teak mb-5">{ui.relatedTitle}</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {topic.related.map((r) => (
          <a
            href={`/en/${r.slug}/`}
            class="group rounded-2xl border border-gold/25 bg-white/50 p-5 hover:border-gold hover:shadow-md transition"
          >
            <div class="font-display text-teak font-semibold text-lg">{r.title}</div>
            <p class="mt-1 text-sm text-ink/70">{r.desc}</p>
            <span class="mt-3 inline-block text-sm text-gold group-hover:text-goldBright">{ui.cta}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-gold/20 pt-6">
      <a href="/en/" class="text-teak font-medium hover:text-gold">{ui.backHome}</a>
      <a href={siteConfig.mapsUrl} target="_blank" rel="noopener" class="text-sm text-gold hover:text-goldBright">
        View Buddha Park on Google Maps ↗
      </a>
    </div>

  </div>
</section>
