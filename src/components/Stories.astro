---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const s = messages.stories;
const isDark = false;
---

<section id="stories" class="py-20 bg-white text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{s.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{s.heading}</h2>
    <p class="mt-4 max-w-2xl text-ink/80">{s.intro}</p>

    <div class="grid md:grid-cols-2 gap-6 mt-10">
      {s.items.map((it) => (
        <article class="rounded-2xl border border-gold/30 bg-ivory/50 p-6 flex flex-col">
          <div class="flex items-center gap-3">
            <span class="chip border-gold/40 text-teak">{it.kind}</span>
          </div>
          <h3 class="font-display text-xl text-teak mt-4">{it.title}</h3>
          <p class="mt-3 text-ink/80 leading-relaxed">{it.text}</p>
        </article>
      ))}
    </div>

    <p class="mt-8 text-xs text-ink/50 leading-relaxed max-w-3xl">{s.note}</p>
  </div>
</section>
