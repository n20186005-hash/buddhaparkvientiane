---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const it = messages.itinerary;
---

<section id="itinerary" class="py-20 bg-ivory text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{it.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{it.heading}</h2>
    <p class="mt-4 max-w-2xl text-ink/80">{it.intro}</p>

    <div class="grid lg:grid-cols-3 gap-6 mt-10">
      {it.items.map((p: any) => (
        <article class="rounded-2xl border border-gold/30 bg-white p-6 flex flex-col">
          <div class="flex items-center justify-between gap-3">
            <span class="chip border-gold/40 text-teak">{p.tag}</span>
            <span class="text-sm text-ink/60">{p.duration}</span>
          </div>
          <h3 class="font-display text-xl text-teak mt-4">{p.title}</h3>
          <p class="mt-3 text-sm text-ink/80 leading-relaxed">{p.desc}</p>
          <ol class="mt-5 space-y-2 border-t border-gold/20 pt-4">
            {p.steps.map((st: string, i: number) => (
              <li class="flex gap-3 text-sm text-ink/85">
                <span class="font-display text-gold mt-0.5">{i + 1}</span>
                <span class="leading-relaxed">{st}</span>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>

    <p class="mt-8 text-xs text-ink/50 leading-relaxed max-w-3xl">{it.note}</p>
  </div>
</section>
