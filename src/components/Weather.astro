---
import { siteConfig } from '../config';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const w = messages.weather;
const A = w.advice ?? {};

const { lat, lng } = siteConfig.coords;
const endpoint =
  `https://api.open-meteo.com/v1/forecast` +
  `?latitude=${lat}&longitude=${lng}` +
  `&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,wind_speed_10m,wind_gusts_10m,is_day` +
  `&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,uv_index_max,wind_speed_10m_max,sunrise,sunset` +
  `&timezone=Asia%2FVientiane&forecast_days=7&alerts=true`;

type Daily = {
  time: string[];
  weather_code: number[];
  temperature_2m_max: number[];
  temperature_2m_min: number[];
  precipitation_probability_max: (number | null)[];
  uv_index_max: (number | null)[];
  wind_speed_10m_max: (number | null)[];
  sunrise: string[];
  sunset: string[];
};
type Alert = { event?: string; description?: string };
type Payload = {
  current?: {
    temperature_2m: number;
    relative_humidity_2m: number;
    apparent_temperature: number;
    precipitation: number;
    weather_code: number;
    wind_speed_10m: number;
    wind_gusts_10m: number;
    is_day: number;
  };
  daily?: Daily;
  alerts?: Alert[];
};

let data: Payload | null = null;
try {
  const res = await fetch(endpoint);
  if (res.ok) data = (await res.json()) as Payload;
} catch {
  data = null;
}

/* ---------- WMO 天气码 → 语义分组 ---------- */
function groupOf(code: number): string {
  if (code === 0) return 'clear';
  if (code === 1) return 'mainlyClear';
  if (code === 2) return 'partlyCloudy';
  if (code === 3) return 'overcast';
  if (code === 45 || code === 48) return 'fog';
  if (code >= 51 && code <= 57) return 'drizzle';
  if (code >= 61 && code <= 67) return 'rain';
  if (code >= 71 && code <= 77) return 'snow';
  if (code >= 85 && code <= 86) return 'snow';
  if (code >= 80 && code <= 82) return 'showers';
  if (code >= 95 && code <= 99) return 'thunder';
  return 'partlyCloudy';
}
const HEAVY_RAIN = new Set([63, 65, 66, 67, 81, 82]);
const isThunder = (c: number) => c >= 95 && c <= 99;
const isHeavy = (c: number) => HEAVY_RAIN.has(c);
const isWet = (c: number) => (c >= 51 && c <= 99) || c === 80;

function glyphOf(g: string, isDay: boolean): string {
  const map: Record<string, [string, string]> = {
    clear: ['☀️', '🌙'],
    mainlyClear: ['🌤️', '🌙'],
    partlyCloudy: ['⛅', '☁️'],
    overcast: ['☁️', '☁️'],
    fog: ['🌫️', '🌫️'],
    drizzle: ['🌦️', '🌦️'],
    rain: ['🌧️', '🌧️'],
    showers: ['🌧️', '🌧️'],
    snow: ['❄️', '❄️'],
    thunder: ['⛈️', '⛈️'],
  };
  const pair = map[g] || map.partlyCloudy;
  return isDay ? pair[0] : pair[1];
}

/* 蒲福风级 */
const BEAUFORT = [1, 5, 11, 19, 28, 38, 49, 61, 74, 88, 102, 117];
function beaufort(kmh: number): number {
  for (let i = 0; i < BEAUFORT.length; i++) if (kmh < BEAUFORT[i]) return i;
  return 12;
}
function uvKey(u: number): string {
  if (u < 3) return 'uvLow';
  if (u < 6) return 'uvModerate';
  if (u < 8) return 'uvHigh';
  if (u < 11) return 'uvVeryHigh';
  return 'uvExtreme';
}

const current = data?.current;
const daily = data?.daily;
const isDay = current ? current.is_day === 1 : true;
const curCode = current?.weather_code ?? 2;
const curGroup = groupOf(curCode);
const curText = w.codes[curGroup] ?? '';
const todayCode = daily?.weather_code?.[0] ?? curCode;
const todayGroup = groupOf(todayCode);

const todayMax = daily?.temperature_2m_max?.[0];
const todayMin = daily?.temperature_2m_min?.[0];
const todayProb = daily?.precipitation_probability_max?.[0] ?? 0;
const todayUv = daily?.uv_index_max?.[0] ?? 0;
const todayWindMax = daily?.wind_speed_10m_max?.[0] ?? 0;
const curWind = current?.wind_speed_10m ?? 0;
const curGust = current?.wind_gusts_10m ?? 0;
const windRef = Math.max(curWind, curGust, todayWindMax);
const range = typeof todayMax === 'number' && typeof todayMin === 'number' ? todayMax - todayMin : 0;

const sunrise = daily?.sunrise?.[0]?.slice(11, 16) ?? '--:--';
const sunset = daily?.sunset?.[0]?.slice(11, 16) ?? '--:--';

/* ---------- 智能建议：动态组合，不满足条件不渲染 ---------- */
const alert = (data?.alerts ?? []).find((x) => !!x?.event);

const risks: string[] = [];
if (alert?.event) {
  risks.push(String(A.alert ?? '').replace('{event}', alert.event));
} else {
  if (isThunder(curCode) || isThunder(todayCode)) risks.push(A.rThunder);
  if (isHeavy(curCode) || isHeavy(todayCode)) risks.push(A.rHeavy);
  if (windRef >= 50) risks.push(A.rGale);
  if (curGroup === 'fog' || todayGroup === 'fog') risks.push(A.rFog);
  if (typeof todayMax === 'number' && todayMax >= 40) risks.push(A.rHeat);
}

/* 出行穿搭：单选，优先级链 */
let dress = A.dDefault;
if (todayGroup === 'snow') dress = A.dSnow;
else if (isHeavy(curCode) || isHeavy(todayCode) || windRef >= 50) dress = A.dRainWind;
else if (isWet(curCode) || isWet(todayCode)) dress = A.dRainLight;
else if (typeof todayMax === 'number' && todayMax >= 32) dress = A.dHot;
else if (typeof todayMax === 'number' && todayMax <= 10) dress = A.dCold;
else if (range > 8) dress = A.dLayers;

/* 游玩安排：单选，优先级链（有预警时安全第一） */
let plan = A.pDefault;
if (alert?.event) plan = A.pAlert;
else if (isThunder(curCode) || isThunder(todayCode)) plan = A.pThunder;
else if (isHeavy(curCode) || isHeavy(todayCode)) plan = A.pHeavy;
else if (isWet(curCode) || isWet(todayCode)) plan = A.pLight;
else if (todayProb >= 60) plan = A.pChance;
else if (todayGroup === 'snow') plan = A.pSnow;
else if (typeof todayMax === 'number' && todayMax >= 32) plan = A.pHot;
else if (todayGroup === 'overcast') plan = A.pOvercast;
else if (todayGroup === 'clear' || todayGroup === 'mainlyClear') plan = A.pClear;

/* 随身物品：可叠加 */
const gear: string[] = [];
if (isHeavy(curCode) || isHeavy(todayCode)) gear.push(A.gRaincoat);
else if (isWet(curCode) || isWet(todayCode) || todayProb >= 60) gear.push(A.gUmbrella);
if (todayUv >= 5 || (typeof todayMax === 'number' && todayMax >= 32)) gear.push(A.gSunscreen);
if (typeof todayMax === 'number' && todayMax >= 32) gear.push(A.gWater);
if ((typeof todayMax === 'number' && todayMax <= 10) || range > 8) gear.push(A.gWarm);
if (curGroup === 'fog' || todayGroup === 'fog') gear.push(A.gMask);
if (!gear.length) gear.push(A.gNone);

const days =
  daily?.time?.map((t, i) => ({
    date: t,
    code: daily.weather_code[i],
    max: Math.round(daily.temperature_2m_max[i]),
    min: Math.round(daily.temperature_2m_min[i]),
    prob: daily.precipitation_probability_max?.[i] ?? 0,
  })) ?? [];

function weekdayOf(iso: string): string {
  const idx = new Date(`${iso}T12:00:00`).getDay();
  return w.dayNames[idx];
}
---

<section id="weather" class="py-20 bg-gradient-to-b from-ivory to-white text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{w.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{w.heading}</h2>
    <p class="mt-4 max-w-2xl text-ink/80">{w.intro}</p>

    {
      !current ? (
        <div class="mt-10 rounded-2xl border border-gold/30 bg-white/60 p-6 text-ink/70">
          {w.errorText}
        </div>
      ) : (
        <>
          {/* 风险提醒：有才显示，置顶红色 */}
          {risks.filter(Boolean).length > 0 && (
            <div class="mt-10 rounded-2xl border-2 border-red-300 bg-red-50 p-5">
              <div class="flex items-center gap-2 text-red-800 font-semibold">
                <span aria-hidden="true">⚠️</span>
                <span>{A.riskLabel}</span>
              </div>
              <ul class="mt-3 space-y-2 text-sm text-red-900/90">
                {risks.filter(Boolean).map((r) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true">•</span>
                    <span>{r}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="mt-6 grid lg:grid-cols-3 gap-6">
            {/* 实况 */}
            <div class="rounded-2xl border border-gold/30 bg-white/70 p-6 shadow-sm">
              <div class="text-xs uppercase tracking-wider text-gold">{w.currentLabel}</div>
              <div class="mt-2 flex items-end gap-4">
                <span class="font-display text-6xl text-teak leading-none">
                  {Math.round(current.temperature_2m)}°
                </span>
                <span class="text-4xl" aria-hidden="true">{glyphOf(curGroup, isDay)}</span>
              </div>
              <div class="mt-2 font-display text-xl text-teak">{curText}</div>
              <dl class="mt-5 grid grid-cols-2 gap-3 text-sm">
                <div>
                  <dt class="text-ink/55">{w.feelsLike}</dt>
                  <dd class="font-semibold text-teak">{Math.round(current.apparent_temperature)}°</dd>
                </div>
                <div>
                  <dt class="text-ink/55">{w.humidity}</dt>
                  <dd class="font-semibold text-teak">{current.relative_humidity_2m}%</dd>
                </div>
                <div>
                  <dt class="text-ink/55">{w.wind}</dt>
                  <dd class="font-semibold text-teak">
                    {w.windLevels[beaufort(curWind)]} · {beaufort(curWind)} {w.windUnit}
                  </dd>
                </div>
                <div>
                  <dt class="text-ink/55">{w.precipProb}</dt>
                  <dd class="font-semibold text-teak">{todayProb}%</dd>
                </div>
                <div>
                  <dt class="text-ink/55">{w.uvIndex}</dt>
                  <dd class="font-semibold text-teak">
                    {Math.round(todayUv)} · {w[uvKey(todayUv)]}
                  </dd>
                </div>
              </dl>
            </div>

            {/* 今日指标 */}
            <div class="rounded-2xl border border-gold/30 bg-white/70 p-6 shadow-sm">
              <div class="text-xs uppercase tracking-wider text-gold">{w.todayLabel}</div>
              <div class="mt-4 space-y-4 text-sm">
                <div class="flex items-center justify-between">
                  <span class="text-ink/70">{w.todayHigh}</span>
                  <span class="font-display text-2xl text-teak">
                    {typeof todayMax === 'number' ? `${Math.round(todayMax)}°` : '—'}
                  </span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-ink/70">{w.todayLow}</span>
                  <span class="font-display text-2xl text-teak/70">
                    {typeof todayMin === 'number' ? `${Math.round(todayMin)}°` : '—'}
                  </span>
                </div>
                <div class="border-t border-gold/20 pt-4 flex items-center justify-between">
                  <span class="text-ink/70">{w.sunrise}</span>
                  <span class="font-semibold text-teak">{sunrise}</span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-ink/70">{w.sunset}</span>
                  <span class="font-semibold text-teak">{sunset}</span>
                </div>
              </div>
              <p class="mt-5 text-xs text-ink/50 leading-relaxed">{w.tipNote}</p>
            </div>

            {/* 智能建议 */}
            <div class="rounded-2xl bg-teak text-ivory p-6 shadow-sm">
              <div class="text-xs uppercase tracking-wider text-goldBright">{w.adviceTitle}</div>

              {risks.filter(Boolean).length === 0 && (
                <p class="mt-3 text-xs text-ivory/60">✓ {A.noRisk}</p>
              )}

              {dress && (
                <div class="mt-4">
                  <div class="text-xs uppercase tracking-wider text-goldBright">{A.dressLabel}</div>
                  <p class="mt-1.5 text-sm text-ivory/90">{dress}</p>
                </div>
              )}

              {plan && (
                <div class="mt-4">
                  <div class="text-xs uppercase tracking-wider text-goldBright">{A.planLabel}</div>
                  <p class="mt-1.5 text-sm text-ivory/90">{plan}</p>
                </div>
              )}

              {gear.filter(Boolean).length > 0 && (
                <div class="mt-4">
                  <div class="text-xs uppercase tracking-wider text-goldBright">{A.gearLabel}</div>
                  <ul class="mt-2 flex flex-wrap gap-2">
                    {gear.filter(Boolean).map((g) => (
                      <li class="rounded-full border border-goldBright/40 bg-ivory/10 px-3 py-1 text-xs text-ivory/90">
                        🎒 {g}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>

          {/* 多日预报 */}
          <div class="mt-8 rounded-2xl border border-gold/30 bg-white/70 p-6 shadow-sm">
            <h3 class="font-display text-xl text-teak">{w.forecastTitle}</h3>
            <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3">
              {days.map((d, i) => (
                <div class="rounded-xl border border-gold/20 bg-ivory/50 p-3 text-center">
                  <div class="text-xs text-ink/60">{i === 0 ? w.todayShort : weekdayOf(d.date)}</div>
                  <div class="text-2xl my-1" aria-hidden="true">{glyphOf(groupOf(d.code), true)}</div>
                  <div class="text-xs text-ink/70 leading-tight">{w.codes[groupOf(d.code)]}</div>
                  <div class="mt-2 font-display text-teak">
                    {d.max}° <span class="text-ink/45 text-sm">{d.min}°</span>
                  </div>
                  <div class="text-xs text-teak/70 mt-1">💧 {d.prob}%</div>
                </div>
              ))}
            </div>
          </div>
        </>
      )
    }
  </div>
</section>
