---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const c = messages.currency;
// 预设金额：门票 / 14 路车费 / 一瓶水（LAK）
const PRESET_VALUES = [15000, 6000, 10000];
---

<section id="currency" class="py-20 bg-ivory text-ink">
  <div class="max-w-5xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{c.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{c.heading}</h2>
    <p class="mt-4 max-w-2xl text-ink/80">{c.intro}</p>

    <div class="mt-8 rounded-2xl border border-gold/30 bg-white p-6 md:p-8">
      <label class="block text-sm text-ink/70" for="lak-input">{c.amountLabel}</label>
      <div class="flex flex-wrap items-center gap-4 mt-2">
        <input
          id="lak-input"
          type="number"
          min="0"
          step="1000"
          value="15000"
          class="w-56 rounded-xl border border-gold/40 bg-ivory/60 px-4 py-3 text-lg text-ink focus:outline-none focus:ring-2 focus:ring-gold"
        />
        <span class="text-sm text-ink/60">{c.unitLabels[0]}</span>
      </div>

      <div class="flex flex-wrap gap-2 mt-4">
        {
          c.presets.map((p: string, i: number) => (
            <button
              type="button"
              class="preset-btn rounded-full border border-gold/40 px-4 py-2 text-sm text-teak hover:bg-gold/10"
              data-value={PRESET_VALUES[i]}
            >
              {p}
            </button>
          ))
        }
      </div>

      <h3 class="font-display text-lg text-teak mt-8">{c.resultLabel}</h3>
      <div id="currency-results" class="grid sm:grid-cols-3 gap-4 mt-4">
        {
          c.unitLabels.slice(1).map((u: string) => (
            <div class="rounded-xl bg-ivory/70 border border-gold/20 px-4 py-4">
              <p class="text-xs uppercase tracking-wide text-ink/60">{u}</p>
              <p class="font-display text-2xl text-teak mt-1" data-currency-out>—</p>
            </div>
          ))
        }
      </div>

      <p id="currency-status" class="mt-5 text-xs text-ink/50 leading-relaxed">{c.loading}</p>
      <p class="mt-3 text-sm text-ink/70">💡 {c.tip}</p>
    </div>
  </div>
</section>

<script
  define:vars={{
    labels: c.unitLabels,
    loading: c.loading,
    errorText: c.error,
    updatedText: c.updated,
    fallbackNote: c.fallbackNote,
  }}
>
  (() => {
    // 离线兜底参考汇率（1 LAK ≈ ...）；联网时以实时汇率覆盖
    const FALLBACK = { USD: 0.000046, THB: 0.0016, CNY: 0.00033 };
    const input = document.getElementById('lak-input');
    const outs = document.querySelectorAll('[data-currency-out]');
    const status = document.getElementById('currency-status');
    if (!input || !outs.length || !status) return;

    let rates = FALLBACK;
    let usedFallback = true;

    const fmt = new Intl.NumberFormat(undefined, { maximumFractionDigits: 2, minimumFractionDigits: 2 });

    function render() {
      const v = parseFloat(input.value) || 0;
      ['USD', 'THB', 'CNY'].forEach((code, i) => {
        const el = outs[i];
        if (el) el.textContent = fmt.format(v * (rates[code] || 0));
      });
    }

    async function loadRates() {
      try {
        const res = await fetch('https://open.er-api.com/v6/latest/LAK');
        const json = await res.json();
        if (json && json.rates && json.rates.USD) {
          rates = json.rates;
          usedFallback = false;
          status.textContent = updatedText;
        } else {
          throw new Error('bad payload');
        }
      } catch (e) {
        rates = FALLBACK;
        usedFallback = true;
        status.textContent = errorText + ' ' + fallbackNote;
      }
      render();
    }

    input.addEventListener('input', render);
    document.querySelectorAll('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        input.value = btn.dataset.value || '0';
        render();
      });
    });

    render();
    loadRates();
  })();
</script>
