---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const f = messages.facilities;
---

<section id="facilities" class="py-20 bg-ivory text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{f.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{f.heading}</h2>
    <p class="mt-4 max-w-2xl text-ink/80">{f.intro}</p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-10">
      {f.items.map((it) => (
        <div class="rounded-2xl border border-gold/30 bg-white/70 p-5">
          <div class="flex items-center gap-3">
            <span class="text-2xl" aria-hidden="true">{it.icon}</span>
            <h3 class="font-display text-lg text-teak">{it.title}</h3>
          </div>
          <p class="mt-3 text-sm text-ink/80 leading-relaxed">{it.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-8 rounded-xl border border-gold/30 bg-teak/5 p-4">
      <p class="text-sm text-ink/75 leading-relaxed">{f.note}</p>
    </div>
  </div>
</section>
