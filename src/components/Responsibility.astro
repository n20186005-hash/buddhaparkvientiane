---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const r = messages.responsibility;
---

<section id="responsibility" class="py-20 bg-teakDeep text-ivory">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{r.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-ivory mt-2">{r.heading}</h2>
    <p class="mt-4 max-w-2xl text-ivory/80">{r.intro}</p>

    <h3 class="font-display text-2xl text-goldBright mt-12">{r.scienceTitle}</h3>
    <div class="grid md:grid-cols-2 gap-6 mt-6">
      {r.science.map((it) => (
        <div class="rounded-2xl border border-gold/25 bg-white/5 p-6">
          <h4 class="font-display text-lg text-goldBright">{it.title}</h4>
          <p class="mt-3 text-ivory/85 leading-relaxed">{it.desc}</p>
        </div>
      ))}
    </div>

    <div class="grid md:grid-cols-2 gap-6 mt-12">
      <div class="rounded-2xl border border-emerald-300/30 bg-emerald-400/5 p-6">
        <h3 class="font-display text-xl text-emerald-200">{r.doTitle}</h3>
        <ul class="mt-4 space-y-2">
          {r.do.map((d) => (
            <li class="flex gap-3 text-sm text-ivory/90">
              <span class="text-emerald-300 mt-0.5" aria-hidden="true">✓</span>
              <span class="leading-relaxed">{d}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl border border-rose-300/30 bg-rose-400/5 p-6">
        <h3 class="font-display text-xl text-rose-200">{r.dontTitle}</h3>
        <ul class="mt-4 space-y-2">
          {r.dont.map((d) => (
            <li class="flex gap-3 text-sm text-ivory/90">
              <span class="text-rose-300 mt-0.5" aria-hidden="true">✕</span>
              <span class="leading-relaxed">{d}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="mt-10 text-sm text-ivory/70 leading-relaxed max-w-3xl border-l-2 border-gold/40 pl-5">
      {r.closing}
    </p>
  </div>
</section>
