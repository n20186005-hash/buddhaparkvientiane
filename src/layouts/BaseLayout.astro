---
import '../styles/global.css';
import { siteConfig } from '../config';
import { htmlLang, languagesList, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  messages: Record<string, any>;
  includeFaq?: boolean;
  /** 抓取预算控制：法律/工具页传 noindex, follow */
  robots?: string;
  /** 规范路径（子页用，如 /en/entrance-fee/；默认 /{lang}/） */
  path?: string;
  /** 是否输出全语种 hreflang（英文专题页传 false → 仅 en + x-default 指向自身） */
  allAlternates?: boolean;
  /** 专题页 FAQ（输出 FAQPage JSON-LD） */
  faqItems?: { q: string; a: string }[];
  /** 面包屑覆盖（专题页用） */
  breadcrumbItems?: { name: string; url?: string }[];
  nearbyAttraction?: { name: string; address: string; map: string; image: string; type: string };
}
const {
  lang,
  title,
  description,
  messages,
  includeFaq = false,
  robots = 'index, follow',
  path,
  allAlternates = true,
  faqItems,
  breadcrumbItems: breadcrumbOverride,
  nearbyAttraction,
} = Astro.props;
const canonical = `${siteConfig.domain}${path ?? `/${lang}/`}`;

// FAQ 合并：guide.faqs（基础）+ extraFaq.items（深度补充，含无人机 / 无障碍 / 姊妹公园）
const faqs = includeFaq && messages?.guide?.faqs
  ? [...messages.guide.faqs, ...(messages.extraFaq?.items ?? [])]
  : (faqItems ?? []);

// ── 实体绑定数据（唯一数据源：src/config.ts + i18n）
const entity = siteConfig.entity;
const fullName = entity.fullName[lang];
const shortName = entity.shortName[lang];
const city = entity.city[lang];
const province = entity.province[lang];
const country = entity.country[lang];
const heroImage = nearbyAttraction?.image
  ? (nearbyAttraction.image.startsWith('/') ? `${siteConfig.domain}${nearbyAttraction.image}` : nearbyAttraction.image)
  : `${siteConfig.domain}/gallery/${siteConfig.galleryPrefix}1.jpg`;
const ogImageAlt = messages?.hero?.imgAlt || `${fullName} — ${city}, ${country}`;

const bc = messages?.about?.breadcrumb;
const derivedBreadcrumb = bc
  ? [
      { name: bc.home, url: canonical },
      { name: bc.country },
      { name: bc.province },
      { name: bc.city },
      { name: bc.current },
    ]
  : [];
const breadcrumbItems = breadcrumbOverride ?? derivedBreadcrumb;

// ── JSON-LD @graph（注意：按合规要求评分/评价不写入结构化数据）
const attraction = {
  '@type': ['TouristAttraction', 'LandmarksOrHistoricalBuildings'],
  '@id': `${siteConfig.domain}/#attraction`,
  name: fullName,
  alternateName: [
    shortName,
    'Buddha Park Vientiane',
    'Buddha Park Laos',
    'Xieng Khuan',
    'Xieng Khouane',
    '万象香昆寺',
    '万佛公园',
    entity.localName,
    `${city} ${fullName}`,
  ],
  description,
  // 实体 URL 统一指向英文主页（六语 + 专题页共用同一 @id 实体）
  url: `${siteConfig.domain}/en/`,
  image: [heroImage],
  isAccessibleForFree: false,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.streetAddress,
    addressLocality: city,
    addressRegion: province,
    postalCode: entity.postalCode,
    addressCountry: entity.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: siteConfig.coords.lat,
    longitude: siteConfig.coords.lng,
  },
  hasMap: siteConfig.mapsUrl,
  sameAs: siteConfig.sameAs,
  touristType: ['Sculpture Park', 'Religious Site'],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '08:00',
      closes: '17:00',
    },
  ],
  // 评分与页面可见的 Reviews 区块一致，来源为 Google 商家资料（mapsUrl）
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: siteConfig.rating,
    reviewCount: Number(String(siteConfig.reviewCount).replace(/[^\d]/g, '')),
    bestRating: 5,
    worstRating: 1,
  },
};

const subjectId = nearbyAttraction ? `${canonical}#attraction` : `${siteConfig.domain}/#attraction`;
const pageAttraction = nearbyAttraction ? {
  '@type': 'TouristAttraction',
  '@id': subjectId,
  name: nearbyAttraction.name,
  description,
  url: canonical,
  image: [heroImage],
  address: { '@type': 'PostalAddress', streetAddress: nearbyAttraction.address, addressCountry: 'LA' },
  hasMap: nearbyAttraction.map,
  touristType: nearbyAttraction.type,
} : attraction;

const graph: Record<string, any>[] = [
  {
    '@type': 'Organization',
    '@id': `${siteConfig.domain}/#organization`,
    name: `${shortName} Visitor Guide`,
    url: siteConfig.domain,
    logo: {
      '@type': 'ImageObject',
      url: `${siteConfig.domain}/icons/icon-512.png`,
    },
  },
  {
    '@type': 'WebSite',
    '@id': `${siteConfig.domain}/#website`,
    url: siteConfig.domain,
    name: `${fullName} — ${city}`,
    inLanguage: htmlLang[lang],
    publisher: { '@id': `${siteConfig.domain}/#organization` },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    isPartOf: { '@id': `${siteConfig.domain}/#website` },
    about: { '@id': subjectId },
    primaryImageOfPage: { '@type': 'ImageObject', url: heroImage },
    datePublished: '2026-01-15',
    dateModified: siteConfig.lastUpdated,
    inLanguage: htmlLang[lang],
  },
  pageAttraction,
];

if (breadcrumbItems.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: breadcrumbItems.map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.name,
      ...(it.url ? { item: it.url } : {}),
    })),
  });
}

if (faqs.length) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faqs.map((f: any) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- GA4：G-HXM22WWPKP（同意门控：仅在用户同意后加载） -->
    <script is:inline>
      (function () {
        var GA_ID = 'G-HXM22WWPKP';
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        function hasConsent() {
          try {
            var raw = localStorage.getItem('cookiePrefs');
            if (!raw) return false;
            var p = JSON.parse(raw);
            return !!(p && p.analytics);
          } catch (e) {
            return false;
          }
        }
        function loadGA() {
          if (window.__gaLoaded) return;
          window.__gaLoaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
          window.gtag('js', new Date());
          window.gtag('config', GA_ID, { anonymize_ip: true });
        }
        if (hasConsent()) loadGA();
        window.addEventListener('consent-updated', function () {
          if (hasConsent()) loadGA();
        });
      })();
    </script>

    <!-- PWA -->
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#3a6b63" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={shortName} />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${fullName} — ${city}`} />
    <meta property="og:locale" content={htmlLang[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={heroImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={heroImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {allAlternates ? (
      languagesList.map((l) => (
        <link rel="alternate" hreflang={htmlLang[l]} href={`${siteConfig.domain}/${l}/`} />
      ))
    ) : (
      <link rel="alternate" hreflang="en" href={canonical} />
    )}
    <link rel="alternate" hreflang="x-default" href={allAlternates ? `${siteConfig.domain}/en/` : canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Trirong:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Sarabun:wght@300;400;500;600;700&family=Charm:wght@400;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="grain">
    <slot />
    <script is:inline>
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
